# Allowed website origins, comma-separated
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:hearthwork@localhost:5432/hearthwork
JWT_SECRET=change-me

# NEAR: the game server account that operates the contracts (see scripts/deploy-contracts.sh).
# Key is read from ~/.near-credentials/testnet/<root>.json, or set NEAR_PRIVATE_KEY=ed25519:...
NEAR_ROOT_ACCOUNT=hearthwork.testnet
# NEAR_PRIVATE_KEY=
# NEAR_DISABLED=true            # run the village fully off-chain
# NEAR_WELCOME_GRANT=0.05       # testnet NEAR given to each new player wallet

# NEAR AI Cloud (OpenAI-compatible) for the shopkeepers. Without it they use rule-based haggling.
# NEARAI_API_KEY=
# NEARAI_MODEL=anthropic/claude-haiku-5-5

# Google sign-in (OAuth web client ID). Without it, username/password sign-in is used.
# GOOGLE_CLIENT_ID=
